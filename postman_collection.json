{
	"info": {
		"_postman_id": "a91f52d0-8cb4-498c-8fce-52dc5e381b1a",
		"name": "TOKO BUKU - Auth API",
		"description": "Koleksi API untuk Register, Login, Me, dan Logout sistem Toko Buku.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "1. Register User",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"if (pm.response.code === 201) {",
							"    var jsonData = pm.response.json();",
							"    if (jsonData.token) {",
							"        pm.collectionVariables.set('bearer_token', jsonData.token);",
							"        console.log('Token otomatis tersimpan:', jsonData.token);",
							"    }",
							"}"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Accept",
						"value": "application/json",
						"type": "text"
					},
					{
						"key": "Content-Type",
						"value": "application/json",
						"type": "text"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"name\": \"Budi Santoso\",\n    \"email\": \"budi@example.com\",\n    \"password\": \"password123\",\n    \"password_confirmation\": \"password123\"\n}",
					"options": {
						"raw": {
							"language": "json"
						}
					}
				},
				"url": {
					"raw": "{{base_url}}/api/v1/register",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"api",
						"v1",
						"register"
					]
				},
				"description": "Mendaftarkan user baru. Token langsung digenerate dan otomatis disimpan ke variabel `bearer_token`."
			},
			"response": []
		},
		{
			"name": "2. Login User",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"if (pm.response.code === 200) {",
							"    var jsonData = pm.response.json();",
							"    if (jsonData.token) {",
							"        pm.collectionVariables.set('bearer_token', jsonData.token);",
							"        console.log('Token otomatis tersimpan:', jsonData.token);",
							"    }",
							"}"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Accept",
						"value": "application/json",
						"type": "text"
					},
					{
						"key": "Content-Type",
						"value": "application/json",
						"type": "text"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"email\": \"budi@example.com\",\n    \"password\": \"password123\"\n}",
					"options": {
						"raw": {
							"language": "json"
						}
					}
				},
				"url": {
					"raw": "{{base_url}}/api/v1/login",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"api",
						"v1",
						"login"
					]
				},
				"description": "Login dengan email dan password. Token otomatis disimpan ke variabel `bearer_token`."
			},
			"response": []
		},
		{
			"name": "3. Get User Profile (Me)",
			"request": {
				"auth": {
					"type": "bearer",
					"bearer": [
						{
							"key": "token",
							"value": "{{bearer_token}}",
							"type": "string"
						}
					]
				},
				"method": "GET",
				"header": [
					{
						"key": "Accept",
						"value": "application/json",
						"type": "text"
					}
				],
				"url": {
					"raw": "{{base_url}}/api/v1/me",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"api",
						"v1",
						"me"
					]
				},
				"description": "Mengambil data profil pengguna yang sedang login menggunakan Bearer Token."
			},
			"response": []
		},
		{
			"name": "4. Logout User",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"if (pm.response.code === 200) {",
							"    pm.collectionVariables.set('bearer_token', '');",
							"    console.log('Token telah direset.');",
							"}"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"auth": {
					"type": "bearer",
					"bearer": [
						{
							"key": "token",
							"value": "{{bearer_token}}",
							"type": "string"
						}
					]
				},
				"method": "POST",
				"header": [
					{
						"key": "Accept",
						"value": "application/json",
						"type": "text"
					}
				],
				"url": {
					"raw": "{{base_url}}/api/v1/logout",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"api",
						"v1",
						"logout"
					]
				},
				"description": "Menghapus token sesi di server. Setelah logout, token tidak dapat digunakan lagi."
			},
			"response": []
		}
	],
	"variable": [
		{
			"key": "base_url",
			"value": "http://127.0.0.1:8000",
			"type": "string"
		},
		{
			"key": "bearer_token",
			"value": "",
			"type": "string"
		}
	]
}
